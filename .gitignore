# Byte-compiled / Python caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution / packaging (anchored to root)
/build/
/dist/
*.egg-info/
*.egg

# Testing & linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Node & Frontend
node_modules/
/marketplace/web/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime & LocalNet state
accounts.json
chain/accounts.json
marketplace/.run/
servers/tests/run/
servers/*/outputs/
servers/tests/outputs/
*.pid
*.log

# Model weights
servers/tts/models/
servers/tts/*.onnx
servers/tts/*.bin
*.onnx
*.bin

# Retain directory structure
!servers/image_gen/data/.gitkeep
!**/.gitkeep

# Environment & Editor files
.env
.env.*
!.env.example
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
