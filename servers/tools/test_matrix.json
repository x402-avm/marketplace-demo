{
 "tts": {
  "tools": [
   "synthesize_speech"
  ],
  "cases": [
   {
    "id": "speak",
    "tool": "synthesize_speech",
    "args": {
     "text": "Hello from the probe.",
     "voice": "af_heart"
    },
    "expect": [
     "(?i)success"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.wav)\\b",
      "min_size": 10000
     }
    ],
    "unique_across_ports": true,
    "timeout": 180
   },
   {
    "id": "too_long",
    "tool": "synthesize_speech",
    "args": {
     "text": ""
    },
    "expect": [
     "1000 character"
    ],
    "must_error": true
   }
  ]
 },
 "web_mcp": {
  "tools": [
   "web_open_page",
   "web_screen_shoot",
   "web_page_info",
   "web_click_button",
   "send_api_request",
   "ddg_search"
  ],
  "cases": [
   {
    "id": "open",
    "tool": "web_open_page",
    "args": {
     "url": "https://example.com"
    },
    "expect": [
     "Opened https://example.com"
    ],
    "timeout": 60
   },
   {
    "id": "info",
    "tool": "web_page_info",
    "args": {},
    "expect": [
     "Example Domain"
    ]
   },
   {
    "id": "shot",
    "tool": "web_screen_shoot",
    "args": {
     "filename": "{TMP}/shot_{PORT}.png"
    },
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.png)\\b",
      "min_size": 2000
     }
    ]
   },
   {
    "id": "click",
    "tool": "web_click_button",
    "args": {
     "selector": "a"
    },
    "expect": [
     "Successfully clicked"
    ],
    "timeout": 60
   },
   {
    "id": "info_url",
    "tool": "web_page_info",
    "args": {
     "url": "https://example.com"
    },
    "expect": [
     "Example Domain"
    ],
    "timeout": 60
   },
   {
    "id": "shot_url",
    "tool": "web_screen_shoot",
    "args": {
     "url": "https://example.com",
     "filename": "probe_shot.png"
    },
    "expect": [
     "Screenshot saved"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.png)\\b",
      "min_size": 2000
     }
    ],
    "timeout": 60
   },
   {
    "id": "click_url",
    "tool": "web_click_button",
    "args": {
     "url": "https://example.com",
     "selector": "a"
    },
    "expect": [
     "Successfully clicked"
    ],
    "timeout": 60
   },
   {
    "id": "api",
    "tool": "send_api_request",
    "args": {
     "url": "https://example.com",
     "method": "GET"
    },
    "expect": [
     "\"status_code\": 200"
    ]
   },
   {
    "id": "search",
    "tool": "ddg_search",
    "args": {
     "query": "Model Context Protocol",
     "max_results": 2
    },
    "expect": [
     "\"results\"",
     "https?://"
    ],
    "timeout": 60
   },
   {
    "id": "neg_api",
    "tool": "send_api_request",
    "args": {
     "url": "http://127.0.0.1:4002/v1/wallets",
     "method": "GET"
    },
    "expect": [
     "blocked private address"
    ],
    "must_error": true
   },
   {
    "id": "neg_open",
    "tool": "web_open_page",
    "args": {
     "url": "http://localhost:4001/v2/status"
    },
    "expect": [
     "blocked private address"
    ],
    "must_error": true
   },
   {
    "id": "neg_shot_path",
    "tool": "web_screen_shoot",
    "args": {
     "filename": "/tmp/x.png"
    },
    "expect": [
     "path not allowed"
    ],
    "must_error": true
   }
  ]
 },
 "invoice_mcp": {
  "tools": [
   "generate_invoice"
  ],
  "cases": [
   {
    "id": "invoice",
    "tool": "generate_invoice",
    "args": {
     "customer_name": "Probe Co",
     "items": [
      {
       "name": "Widget",
       "amount": 10.5,
       "quantity": 2
      },
      {
       "name": "Setup",
       "amount": 5.0,
       "quantity": 1
      }
     ]
    },
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.pdf)\\b",
      "pdf_text": [
       "Probe Co",
       "Widget",
       "26.00"
      ]
     }
    ]
   }
  ]
 },
 "domain_mcp": {
  "tools": [
   "domain_whois",
   "domain_dns",
   "domain_ssl",
   "domain_ip"
  ],
  "cases": [
   {
    "id": "whois",
    "tool": "domain_whois",
    "args": {
     "domain": "github.com"
    },
    "expect": [
     "(?i)github"
    ],
    "reject": [
     "\"detail\""
    ],
    "timeout": 60
   },
   {
    "id": "dns",
    "tool": "domain_dns",
    "args": {
     "domain": "github.com"
    },
    "expect": [
     "\"A\"",
     "\\d+\\.\\d+\\.\\d+\\.\\d+"
    ]
   },
   {
    "id": "ssl",
    "tool": "domain_ssl",
    "args": {
     "domain": "github.com"
    },
    "expect": [
     "\\d{4} GMT"
    ]
   },
   {
    "id": "ip",
    "tool": "domain_ip",
    "args": {
     "domain": "github.com"
    },
    "expect": [
     "\\d+\\.\\d+\\.\\d+\\.\\d+"
    ]
   },
   {
    "id": "bad_domain",
    "tool": "domain_ip",
    "args": {
     "domain": "no-such-host-xyz.invalid"
    },
    "expect": [
     "(?i)error|not known|failed|detail"
    ],
    "must_error": true
   }
  ]
 },
 "yt_mcp": {
  "tools": [
   "download_yt_video",
   "get_yt_transcript"
  ],
  "cases": [
   {
    "id": "transcript",
    "tool": "get_yt_transcript",
    "args": {
     "video_id": "jNQXAC9IVRw"
    },
    "expect": [
     "success",
     "(?i)elephant"
    ],
    "timeout": 90
   },
   {
    "id": "download",
    "tool": "download_yt_video",
    "args": {
     "url": "https://www.youtube.com/watch?v=jNQXAC9IVRw",
     "format": "audio"
    },
    "expect": [
     "yt_mcp/outputs"
    ],
    "artifacts": [
     {
      "regex": "'file': '([^']+)'",
      "min_size": 20000
     }
    ],
    "timeout": 300
   }
  ]
 },
 "sandbox_mcp": {
  "tools": [
   "run_sandbox_code"
  ],
  "cases": [
   {
    "id": "python",
    "tool": "run_sandbox_code",
    "args": {
     "language": "python",
     "code": "print(sum(range(10)))"
    },
    "expect": [
     "Stdout:\\n45"
    ]
   },
   {
    "id": "javascript",
    "tool": "run_sandbox_code",
    "args": {
     "language": "javascript",
     "code": "console.log(6*7)"
    },
    "expect": [
     "Stdout:\\n42"
    ]
   },
   {
    "id": "c",
    "tool": "run_sandbox_code",
    "args": {
     "language": "c",
     "code": "#include <stdio.h>\nint main(){printf(\"c-ok %d\\n\", 3*3);return 0;}"
    },
    "expect": [
     "c-ok 9"
    ],
    "timeout": 60
   },
   {
    "id": "cpp",
    "tool": "run_sandbox_code",
    "args": {
     "language": "cpp",
     "code": "#include <iostream>\nint main(){std::cout<<\"cpp-ok \"<<4*4<<std::endl;}"
    },
    "expect": [
     "cpp-ok 16"
    ],
    "timeout": 60
   },
   {
    "id": "java",
    "tool": "run_sandbox_code",
    "args": {
     "language": "java",
     "code": "public class Main{public static void main(String[] a){System.out.println(\"java-ok \"+5*5);}}"
    },
    "expect": [
     "java-ok 25"
    ],
    "timeout": 60
   },
   {
    "id": "timeout",
    "tool": "run_sandbox_code",
    "args": {
     "language": "python",
     "code": "while True: pass"
    },
    "expect": [
     "(?i)timed out"
    ],
    "timeout": 60
   },
   {
    "id": "unsupported",
    "tool": "run_sandbox_code",
    "args": {
     "language": "cobol",
     "code": "x"
    },
    "expect": [
     "(?i)unsupported"
    ],
    "must_error": true
   }
  ]
 },
 "latex_mcp": {
  "tools": [
   "compile_latex_to_pdf"
  ],
  "cases": [
   {
    "id": "compile",
    "tool": "compile_latex_to_pdf",
    "args": {
     "latex_string": "\\documentclass{article}\\begin{document}Probe LaTeX 42\\end{document}"
    },
    "expect": [
     "latex_mcp/outputs"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.pdf)\\b",
      "pdf_text": [
       "Probe LaTeX 42"
      ]
     }
    ],
    "timeout": 90
   },
   {
    "id": "broken",
    "tool": "compile_latex_to_pdf",
    "args": {
     "latex_string": "\\documentclass{article}\\begin{document}\\undefinedmacro\\end{document"
    },
    "expect": [
     "(?i)error|failed"
    ],
    "must_error": true,
    "timeout": 90
   }
  ]
 },
 "conversion_mcp": {
  "tools": [
   "document_convert",
   "data_convert",
   "image_convert",
   "audio_convert",
   "video_convert",
   "archive_create",
   "archive_extract"
  ],
  "cases": [
   {
    "id": "doc",
    "tool": "document_convert",
    "args": {
     "file_url": "{FIX}/doc.html",
     "from_format": "html",
     "to_format": "pdf"
    },
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.pdf)\\b",
      "pdf_text": [
       "Hello conversion"
      ]
     }
    ],
    "timeout": 120
   },
   {
    "id": "data",
    "tool": "data_convert",
    "args": {
     "file_url": "{FIX}/data.json",
     "from_format": "json",
     "to_format": "csv"
    },
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.csv)\\b",
      "contains": [
       "name",
       "alice",
       "78"
      ],
      "min_size": 10
     }
    ]
   },
   {
    "id": "image",
    "tool": "image_convert",
    "args": {
     "file_url": "{FIX}/sample.jpg",
     "from_format": "jpg",
     "to_format": "png"
    },
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.png)\\b",
      "image_size": [
       200,
       200
      ]
     }
    ]
   },
   {
    "id": "audio",
    "tool": "audio_convert",
    "args": {
     "file_url": "{FIX}/tone.wav",
     "from_format": "wav",
     "to_format": "mp3"
    },
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.mp3)\\b",
      "duration": [
       1.8,
       2.3
      ]
     }
    ],
    "timeout": 60
   },
   {
    "id": "video",
    "tool": "video_convert",
    "args": {
     "file_url": "{FIX}/sample.mp4",
     "from_format": "mp4",
     "to_format": "webm"
    },
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.webm)\\b",
      "duration": [
       5.5,
       6.5
      ]
     }
    ],
    "timeout": 180
   },
   {
    "id": "zip",
    "tool": "archive_create",
    "args": {
     "file_urls": [
      "{FIX}/data.json",
      "{FIX}/doc.html"
     ],
     "format": "zip"
    },
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.zip)\\b",
      "zip_entries": 2
     }
    ]
   },
   {
    "id": "unzip",
    "tool": "archive_extract",
    "args": {
     "file_url": "{FIX}/bundle.zip",
     "format": "zip"
    },
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "artifacts": [
     {
      "regex": "(/[\\w./+-]+)",
      "dir_contains": [
       "data.json",
       "doc.html"
      ]
     }
    ]
   },
   {
    "id": "neg_path",
    "tool": "data_convert",
    "args": {
     "file_url": "/etc/passwd",
     "from_format": "json",
     "to_format": "csv"
    },
    "expect": [
     "path not allowed"
    ],
    "must_error": true
   },
   {
    "id": "neg_url",
    "tool": "document_convert",
    "args": {
     "file_url": "http://127.0.0.1:4002/v1/wallets",
     "from_format": "html",
     "to_format": "pdf"
    },
    "expect": [
     "blocked private address"
    ],
    "must_error": true
   }
  ]
 },
 "ocr_mcp": {
  "tools": [
   "image_to_text",
   "pdf_to_text",
   "handwriting_ocr",
   "table_extraction",
   "math_ocr",
   "receipt_ocr",
   "barcode_reader"
  ],
  "cases": [
   {
    "id": "image",
    "tool": "image_to_text",
    "args": {
     "image_url": "{FIX}/text.png"
    },
    "expect": [
     "(?i)hello\\s*probe"
    ],
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "timeout": 120
   },
   {
    "id": "pdf",
    "tool": "pdf_to_text",
    "args": {
     "pdf_url": "{FIX}/probe.pdf"
    },
    "expect": [
     "architecture"
    ],
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR"
    ],
    "timeout": 120
   },
   {
    "id": "hand",
    "tool": "handwriting_ocr",
    "args": {
     "image_url": "{FIX}/text.png"
    },
    "expect": [
     "(?i)probe"
    ],
    "reject": [
     "example\\.com",
     "The quick brown fox",
     "Chapter 1: Introduction to OCR",
     "Dear John"
    ],
    "timeout": 120
   },
   {
    "id": "table",
    "tool": "table_extraction",
    "args": {
     "image_or_pdf_url": "{FIX}/table.png"
    },
    "expect": [
     "Banana",
     "0\\.50"
    ],
    "timeout": 120
   },
   {
    "id": "math",
    "tool": "math_ocr",
    "args": {
     "image_url": "{FIX}/math.png"
    },
    "expect": [
     "x\\^\\{?2",
     "7"
    ],
    "reject": [
     "\\\\int"
    ],
    "timeout": 120
   },
   {
    "id": "receipt",
    "tool": "receipt_ocr",
    "args": {
     "image_url": "{FIX}/receipt.png"
    },
    "expect": [
     "45\\.99",
     "(?i)probe mart"
    ],
    "reject": [
     "Target"
    ],
    "timeout": 120
   },
   {
    "id": "qr",
    "tool": "barcode_reader",
    "args": {
     "image_url": "{FIX}/qr.png"
    },
    "expect": [
     "https://probe\\.local/abc"
    ],
    "timeout": 60
   },
   {
    "id": "neg_url",
    "tool": "image_to_text",
    "args": {
     "image_url": "http://localhost:8980/health"
    },
    "expect": [
     "blocked private address"
    ],
    "must_error": true
   }
  ]
 },
