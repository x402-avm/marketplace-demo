 "image_edit_mcp": {
  "tools": [
   "compress_image",
   "resize_image"
  ],
  "cases": [
   {
    "id": "compress",
    "tool": "compress_image",
    "args": {
     "image_path": "{FIX}/sample.jpg",
     "quality": 40
    },
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.jpg)\\b"
     }
    ]
   },
   {
    "id": "resize",
    "tool": "resize_image",
    "args": {
     "image_path": "{FIX}/sample.jpg",
     "width": 64,
     "height": 48
    },
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.png)\\b",
      "image_size": [
       64,
       48
      ]
     }
    ]
   },
   {
    "id": "missing",
    "tool": "resize_image",
    "args": {
     "image_path": "/nonexistent.jpg",
     "width": 10,
     "height": 10
    },
    "expect": [
     "(?i)not found|error|404"
    ],
    "must_error": true
   },
   {
    "id": "neg_path",
    "tool": "resize_image",
    "args": {
     "image_path": "/etc/passwd",
     "width": 10,
     "height": 10
    },
    "expect": [
     "path not allowed"
    ],
    "must_error": true
   }
  ]
 },
 "video_edit_mcp": {
  "tools": [
   "trim_video"
  ],
  "cases": [
   {
    "id": "trim",
    "tool": "trim_video",
    "args": {
     "video_path": "{FIX}/sample.mp4",
     "start_sec": 1.0,
     "end_sec": 3.0
    },
    "artifacts": [
     {
      "regex": "([\\w./+-]+\\.mp4)\\b",
      "duration": [
       1.7,
       2.4
      ]
     }
    ],
    "timeout": 120
   },
   {
    "id": "neg_path",
    "tool": "trim_video",
    "args": {
     "video_path": "/etc/passwd",
     "start_sec": 1.0,
     "end_sec": 3.0
    },
    "expect": [
     "path not allowed"
    ],
    "must_error": true
   }
  ]
 },
 "paper_mcp": {
  "tools": [
   "search_papers"
  ],
  "cases": [
   {
    "id": "search",
    "tool": "search_papers",
    "args": {
     "query": "attention is all you need",
     "max_results": 2
    },
    "expect": [
     "\"title\"",
     "arxiv\\.org"
    ],
    "reject": [
     "\"status\": \"error\""
    ],
    "timeout": 90
   }
  ]
 },
 "image_gen": {
  "tools": [
   "generate_image",
   "edit_image",
   "optimize_prompt",
   "analyze_image_quality",
   "get_hardware_status"
  ],
  "cases": [
   {
    "id": "hw",
    "tool": "get_hardware_status",
    "args": {},
    "expect": [
     "(?i)cpu"
    ]
   },
   {
    "id": "optimize",
    "tool": "optimize_prompt",
    "args": {
     "prompt": "a red fox in snow"
    },
    "expect": [
     "(?i)fox"
    ]
   },
   {
    "id": "qa",
    "tool": "analyze_image_quality",
    "args": {
     "image_path": "{FIX}/sample.jpg"
    },
    "expect": [
     "(?i)quality_score"
    ]
   },
   {
    "id": "generate",
    "tool": "generate_image",
    "args": {
     "prompt": "a red fox in snow",
     "steps": 4
    },
    "expect": [
     "\"status\": \"success\"",
     "\"backend\": \"diffusers:"
    ],
    "reject": [
     "fast_test_placeholder"
    ],
    "artifacts": [
     {
      "regex": "\"file_path\": \"([^\"]+)\"",
      "min_size": 100000
     }
    ],
    "timeout": 900
   },
   {
    "id": "neg_path",
    "tool": "analyze_image_quality",
    "args": {
     "image_path": "/etc/passwd"
    },
    "expect": [
     "path not allowed"
    ],
    "must_error": true
   },
   {
    "id": "edit",
    "tool": "edit_image",
    "args": {
     "image_path": "{FIX}/sample.jpg",
     "prompt": "make it snowy",
     "steps": 2
    },
    "expect": [
     "\"success\"|\"status\": \"success\""
    ],
    "timeout": 900
   }
  ]
 }
}